source 'https://rubygems.org'

gem 'rails', '~> 8.1.0'
gem 'rspec', '~> 3.12'
gem 'rake'
gem 'gemika', '>= 0.8.1'

# The default `Gemfile` is symlinked to to this one.
# Because of that, we also need to load rubocop just here.
gem 'rubocop'
gem 'makandra-rubocop'
gem 'rubocop-rake'
gem 'rubocop-rspec'

gem 'precompiled_assets', path: '.'
